---
import { nav, siteName, siteShortName } from '../config';

const current = Astro.url.pathname;

function strip(value: string) {
  return value !== '/' && value.endsWith('/') ? value.slice(0, -1) : value;
}

function active(href: string) {
  const page = strip(current);
  const target = strip(href);
  if (target === '/') return page === '/';
  return page === target || page.startsWith(`${target}/`);
}
---

<header class="site-header">
  <div class="wrap header-bar">
    <a class="brand" href="/" aria-label={siteName}>
      <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="#1e4f45"></rect>
        <rect x="7" y="8" width="18" height="3" rx="1.5" fill="#f4f0e6"></rect>
        <rect x="7" y="14.5" width="12" height="3" rx="1.5" fill="#f0b08a"></rect>
        <rect x="7" y="21" width="15" height="3" rx="1.5" fill="#f4f0e6"></rect>
      </svg>
      <span class="brand-text">
        <span class="brand-name">{siteName}</span>
        <span class="brand-short">{siteShortName}</span>
      </span>
    </a>
    <nav id="site-nav" class="site-nav" data-nav aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-actions">
      <button class="theme-toggle" type="button" data-theme-toggle>Theme</button>
      <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-nav">
        Menu
      </button>
    </div>
  </div>
</header>
