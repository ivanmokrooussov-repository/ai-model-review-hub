---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="That page is not on AI Model & Tool Review Hub."
  path="/404.html"
  noindex={true}
>
  <div class="wrap doc">
    <header class="doc-header">
      <h1>That page is not here</h1>
      <p class="lede">The link may be old, or the address may have a typo. The guides are still listed.</p>
    </header>
    <p>
      <a class="button" href="/guides/">Browse guides</a>
    </p>
  </div>
</Base>
