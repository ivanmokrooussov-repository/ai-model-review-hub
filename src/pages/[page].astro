---
import { getEntry, render, type CollectionEntry } from 'astro:content';
import EmailCard from '../components/EmailCard.astro';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pageIds = ['about', 'methodology', 'affiliate-disclosure', 'privacy', 'contact'] as const;
  const entries = await Promise.all(
    pageIds.map(async (id) => {
      const entry = await getEntry('pages', id);
      if (!entry) throw new Error(`Missing content/pages/${id}.md`);
      return entry;
    }),
  );
  return entries.map((entry) => ({
    params: { page: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/${entry.id}/`;
---

<Base title={entry.data.title} description={entry.data.description} path={path}>
  <article class="wrap doc">
    <header class="doc-header">
      <h1>{entry.data.title}</h1>
    </header>
    {entry.id === 'contact' && <EmailCard />}
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
