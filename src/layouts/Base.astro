---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import { serializeJsonLd } from '../lib/format';

interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  published?: string;
  structuredData?: unknown[];
}

const {
  title,
  description,
  path,
  ogType = 'website',
  noindex = false,
  published,
  structuredData = [],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (error) {
          /* Preference storage can be blocked. The site still follows the system theme. */
        }
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f3efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
    <Seo
      title={title}
      description={description}
      path={path}
      ogType={ogType}
      noindex={noindex}
      published={published}
    />
    {
      structuredData.map((entry) => (
        <script type="application/ld+json" set:html={serializeJsonLd(entry)} />
      ))
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var themeButton = document.querySelector('[data-theme-toggle]');
        var navButton = document.querySelector('[data-nav-toggle]');
        var nav = document.querySelector('[data-nav]');

        function currentTheme() {
          var explicit = root.getAttribute('data-theme');
          if (explicit === 'light' || explicit === 'dark') return explicit;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function paintThemeButton() {
          if (!themeButton) return;
          var next = currentTheme() === 'dark' ? 'light' : 'dark';
          themeButton.textContent = next === 'dark' ? 'Dark' : 'Light';
          themeButton.setAttribute('aria-label', 'Switch to ' + next + ' theme');
        }

        themeButton &&
          themeButton.addEventListener('click', function () {
            var next = currentTheme() === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try {
              localStorage.setItem('theme', next);
            } catch (error) {
              /* Ignore storage failures. The choice still applies to this page view. */
            }
            paintThemeButton();
          });

        function setNav(open) {
          if (!nav || !navButton) return;
          nav.classList.toggle('is-open', open);
          navButton.setAttribute('aria-expanded', open ? 'true' : 'false');
          navButton.textContent = open ? 'Close' : 'Menu';
        }

        navButton &&
          navButton.addEventListener('click', function () {
            var open = navButton.getAttribute('aria-expanded') !== 'true';
            setNav(open);
          });

        nav &&
          nav.querySelectorAll('a').forEach(function (link) {
            link.addEventListener('click', function () {
              setNav(false);
            });
          });

        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') setNav(false);
        });

        paintThemeButton();
      })();
    </script>
  </body>
</html>
